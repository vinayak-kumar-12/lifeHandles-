# Environment Mode (development | production)
NODE_ENV=production

# Server Host & Port (0.0.0.0 binds to all network interfaces for cloud hosting)
HOST=0.0.0.0
PORT=3000

# PostgreSQL Production Connection String (Cloud PostgreSQL: Supabase, Neon, Render, Railway, AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Authentication Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_super_secret_access_key_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_chars

# Token Lifespan
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Verification
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Production SMTP Email Delivery (SendGrid, Mailgun, Amazon SES, Brevo)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=PadosiPro

# Allowed CORS Origins (Comma-separated for web dashboards; mobile apps pass through automatically)
CORS_ORIGIN=https://app.yourdomain.com,https://yourdomain.com

# Rate Limiting (100 requests per 15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
